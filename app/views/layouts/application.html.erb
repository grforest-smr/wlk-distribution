<!DOCTYPE html>
<html>
<head>
  <title>WlkDistribution</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>
<body>
  <%= yield %>
  
  <script>
    console.log('Script loaded');

    function showMessage(text, type) {
      const msg = document.getElementById('uploadMessage');
      if (msg) {
        msg.textContent = text;
        msg.className = `p-4 rounded ${
          type === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'
        }`;
        msg.classList.remove('hidden');
        setTimeout(() => msg.classList.add('hidden'), 5000);
      }
    }

    async function loadSettings() {
      try {
        const response = await fetch('/api/v1/configs');
        const result = await response.json();
        if (result.status === 'success') {
          result.data.forEach(config => {
            const input = document.getElementById(config.key);
            if (input) input.value = config.value;
          });
        }
      } catch (error) {
        console.error('Error loading settings:', error);
      }
    }

    async function loadBuildingTypes() {
      try {
        const response = await fetch('/api/v1/building_troop_types');
        const result = await response.json();
        
        const allBuildings = [
          { key: 'tower_tc', name: 'tc' },
          { key: 'tower_north', name: 'north' },
          { key: 'tower_south', name: 'south' },
          { key: 'tower_west', name: 'west' },
          { key: 'tower_east', name: 'east' }
        ];
        
        const translations = JSON.parse(document.querySelector('[data-controller="index"]').dataset.translations);
        
        const containerSlot1 = document.getElementById('buildingTypesSlot1');
        const containerSlot2 = document.getElementById('buildingTypesSlot2');
        
        if (!containerSlot1 || !containerSlot2) return;
        
        containerSlot1.innerHTML = '';
        containerSlot2.innerHTML = '';
        
        const typesBySlot = { 1: {}, 2: {} };
        if (result.status === 'success') {
          result.data.forEach(item => {
            typesBySlot[item.slot][item.building] = item.troop_type;
          });
        }
        
        function createBuildingSelect(building, slot, currentValue) {
          const div = document.createElement('div');
          div.className = 'flex items-center mb-2';
          
          const label = document.createElement('span');
          label.className = 'w-48 font-medium';
          label.textContent = `${translations[building.key]}:`;
          div.appendChild(label);
          
          const select = document.createElement('select');
          select.dataset.building = building.name;
          select.dataset.slot = slot;
          select.className = `building-type-select flex-1 p-2 border rounded`;
          
          const options = [
            { value: '', text: translations['auto'] },
            { value: 'fighter', text: translations['fighter'] },
            { value: 'archer', text: translations['archer'] },
            { value: 'rider', text: translations['rider'] }
          ];
          
          options.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt.value;
            option.textContent = opt.text;
            option.selected = currentValue === opt.value;
            select.appendChild(option);
          });
          
          div.appendChild(select);
          return div;
        }
        
        allBuildings.forEach(building => {
          containerSlot1.appendChild(createBuildingSelect(building, 1, typesBySlot[1][building.name] || ''));
        });
        
        allBuildings.forEach(building => {
          containerSlot2.appendChild(createBuildingSelect(building, 2, typesBySlot[2][building.name] || ''));
        });
        
      } catch (error) {
        console.error('Error loading building types:', error);
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM loaded');
      
      const translations = JSON.parse(document.querySelector('[data-controller="index"]').dataset.translations);
      
      const t = (key, params = {}) => {
        let value = translations[key];
        
        // Handle pluralization objects
        if (typeof value === 'object' && value !== null) {
          const count = params.count;
          if (count !== undefined) {
            let pluralKey = 'other';
            if (count % 10 === 1 && count % 100 !== 11) pluralKey = 'one';
            else if ([2,3,4].includes(count % 10) && ![12,13,14].includes(count % 100)) pluralKey = 'few';
            else if (count % 10 === 0 || [5,6,7,8,9].includes(count % 10) || [11,12,13,14].includes(count % 100)) pluralKey = 'many';
            value = value[pluralKey] || value['other'] || key;
          } else {
            value = value['other'] || Object.values(value)[0] || key;
          }
        }
        
        if (typeof value !== 'string') return key;
        
        Object.keys(params).forEach(param => {
          value = value.replace(`{${param}}`, params[param]);
          value = value.replace(`%{${param}}`, params[param]);
        });
        
        return value;
      };
      
      loadSettings();
      loadBuildingTypes();
      
      // ===== Функции сброса (теперь внутри DOMContentLoaded) =====
      async function resetSlot1() {
        if (!confirm(t('confirmReset'))) return;
        
        try {
          const allBuildings = ['tc', 'north', 'south', 'west', 'east'];
          
          for (const building of allBuildings) {
            await fetch(`/api/v1/building_troop_types/1/${encodeURIComponent(building)}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ troop_type: '' })
            });
          }
          
          showMessage(t('slot1Reset'), 'success');
          loadBuildingTypes();
        } catch (error) {
          console.error('Error resetting slot 1:', error);
          showMessage(t('error'), 'error');
        }
      }
      
      async function resetSlot2() {
        if (!confirm(t('confirmReset'))) return;
        
        try {
          const allBuildings = ['tc', 'north', 'south', 'west', 'east'];
          
          for (const building of allBuildings) {
            await fetch(`/api/v1/building_troop_types/2/${encodeURIComponent(building)}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ troop_type: '' })
            });
          }
          
          showMessage(t('slot2Reset'), 'success');
          loadBuildingTypes();
        } catch (error) {
          console.error('Error resetting slot 2:', error);
          showMessage(t('error'), 'error');
        }
      }
      // ===== Конец функций сброса =====
      
      // Upload CSV
      const uploadBtn = document.getElementById('uploadCsvBtn');
      if (uploadBtn) {
        uploadBtn.addEventListener('click', async function(event) {
          event.preventDefault();
          
          const file = document.getElementById('csvFile').files[0];
          if (!file) {
            showMessage(t('fileRequired'), 'error');
            return;
          }

          const useStrength = document.getElementById('useStrength').checked;
          const formData = new FormData();
          formData.append('file', file);
          formData.append('use_strength', useStrength);

          try {
            const response = await fetch('/api/v1/players/upload_csv', {
              method: 'POST',
              body: formData
            });
            
            const result = await response.json();
            
            if (result.status === 'success') {
              showMessage(t('playersLoaded', { count: result.count }), 'success');
              
              const countElement = document.getElementById('playerCount');
              if (countElement) {
                countElement.textContent = t('loadedCount', { count: result.count });
              }
              
              if (result.players && result.players.length > 0) {
                displayPlayerStats(result.players);
              } else {
                const statsContainer = document.getElementById('playerStats');
                if (statsContainer) statsContainer.classList.add('hidden');
              }
            } else {
              showMessage(`❌ ${result.message}`, 'error');
            }
          } catch (error) {
            showMessage(t('error'), 'error');
            console.error(error);
          }
        });
      }
      
      // Show players
      const showPlayersBtn = document.getElementById('showPlayersBtn');
      if (showPlayersBtn) {
        showPlayersBtn.addEventListener('click', async function(event) {
          event.preventDefault();
          
          try {
            const response = await fetch('/api/v1/players');
            const result = await response.json();
            
            if (result.status === 'success') {
              const container = document.getElementById('playersTable');
              container.innerHTML = '';
              
              if (result.data.length === 0) {
                container.innerHTML = '<p class="text-gray-500">' + t('no_players') + '</p>';
              } else {
                let html = `<table class="min-w-full border"><tr>
                  <th class="border p-2">${t('nickname')}</th>
                  <th class="border p-2">${t('alliance')}</th>
                  <th class="border p-2">${t('type')}</th>
                  <th class="border p-2">${t('march')}</th>
                  <th class="border p-2">${t('ga')}</th>
                </tr>`;
                
                result.data.forEach(p => {
                  html += `<tr>
                    <td class="border p-2">${p.nickname}</td>
                    <td class="border p-2">${p.alliance || '-'}</td>
                    <td class="border p-2">${t(p.troop_type?.toLowerCase() || 'fighter')}</td>
                    <td class="border p-2 text-right">${p.march_size?.toLocaleString()}</td>
                    <td class="border p-2 text-right">${p.group_attack?.toLocaleString()}</td>
                  </tr>`;
                });
                html += '</table>';
                container.innerHTML = html;
              }
              document.getElementById('playersList').classList.remove('hidden');
            }
          } catch (error) {
            console.error(error);
          }
        });
      }
      
      // Save settings
      const saveSettingsBtn = document.getElementById('saveSettingsBtn');
      if (saveSettingsBtn) {
        saveSettingsBtn.addEventListener('click', async function(event) {
          event.preventDefault();
          
          const settings = [
            { key: 'max_players_in_tower', value: document.getElementById('max_players_in_tower').value },
            { key: 'max_players_in_tc', value: document.getElementById('max_players_in_tc').value },
            { key: 'reserve_per_building', value: document.getElementById('reserve_per_building').value }
          ];

          try {
            for (const setting of settings) {
              await fetch(`/api/v1/configs/${setting.key}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ value: setting.value })
              });
            }
            showMessage(t('settingsSaved'), 'success');
          } catch (error) {
            showMessage(t('error'), 'error');
          }
        });
      }
      
      // Save building types
      const saveTypesBtn = document.getElementById('saveTypesBtn');
      if (saveTypesBtn) {
        saveTypesBtn.addEventListener('click', async function(event) {
          event.preventDefault();
          
          const selects = document.querySelectorAll('.building-type-select');
          
          try {
            for (const select of selects) {
              const building = select.dataset.building;
              const slot = select.dataset.slot;
              const troop_type = select.value;
              
              const response = await fetch(`/api/v1/building_troop_types/${slot}/${encodeURIComponent(building)}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ troop_type })
              });
              
              if (!response.ok) {
                const errorData = await response.json();
                console.error('Error:', errorData);
                throw new Error(`HTTP error! status: ${response.status}`);
              }
            }
            showMessage(t('typesSaved'), 'success');
            loadBuildingTypes();
          } catch (error) {
            console.error('Save error:', error);
            showMessage(t('error'), 'error');
          }
        });
      }
      
      // Run distribution
      const runDistBtn = document.getElementById('runDistributionBtn');
      if (runDistBtn) {
        runDistBtn.addEventListener('click', async function(event) {
          event.preventDefault();
          
          const useStrength = document.getElementById('useStrength').checked;
          
          try {
            const response = await fetch('/api/v1/distributions/run', { 
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ use_strength: useStrength })
            });
            const result = await response.json();
            
            if (result.status === 'success') {
              showMessage(t('distributionCompleted'), 'success');
              displayResults(result.data);
            } else {
              showMessage(`❌ ${result.message}`, 'error');
            }
          } catch (error) {
            showMessage(t('error'), 'error');
            console.error(error);
          }
        });
      }

      // Сброс слота 1
      const resetSlot1Btn = document.getElementById('resetSlot1Btn');
      if (resetSlot1Btn) {
        resetSlot1Btn.addEventListener('click', resetSlot1);
      }

      // Сброс слота 2
      const resetSlot2Btn = document.getElementById('resetSlot2Btn');
      if (resetSlot2Btn) {
        resetSlot2Btn.addEventListener('click', resetSlot2);
      }

      // Display player statistics
      function displayPlayerStats(players) {
        const statsContainer = document.getElementById('playerStats');
        if (!statsContainer) return;
        
        const total = players.length;
        
        const typeCount = { fighter:0, archer:0, rider:0 };
        const levelCount = {};
        const slotCount = { slot1:0, slot2:0, any:0 };
        const captainDesire = { Да:0, Нет:0, 'Не важно':0 };
        
        players.forEach(p => {
          if (p.troop_type === 'fighter') typeCount.fighter++;
          else if (p.troop_type === 'archer') typeCount.archer++;
          else if (p.troop_type === 'rider') typeCount.rider++;
          
          levelCount[p.level] = (levelCount[p.level] || 0) + 1;
          
          if (p.slot === 'slot1') slotCount.slot1++;
          else if (p.slot === 'slot2') slotCount.slot2++;
          else slotCount.any++;
          
          const desire = p.wants_captain || 'Не важно';
          captainDesire[desire] = (captainDesire[desire] || 0) + 1;
        });
        
        const sortedLevels = Object.keys(levelCount).sort((a, b) => {
          const numA = parseInt(a.replace('T','')) || 0;
          const numB = parseInt(b.replace('T','')) || 0;
          return numB - numA;
        });
        
        let html = `
          <h2 class="text-2xl font-semibold mb-4">${t('analytics')}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="font-bold mb-2">${t('total')}</h3>
              <table class="w-full">
                <tr><td class="py-1">${t('total')}:</td><td class="text-right font-bold">${total}</td></tr>
              </table>
            </div>
            <div>
              <h3 class="font-bold mb-2">${t('byType')}</h3>
              <table class="w-full">
                <tr><td class="py-1">${t('fighter')}:</td><td class="text-right font-bold">${typeCount.fighter} (${((typeCount.fighter/total)*100).toFixed(1)}%)</td></tr>
                <tr><td class="py-1">${t('archer')}:</td><td class="text-right font-bold">${typeCount.archer} (${((typeCount.archer/total)*100).toFixed(1)}%)</td></tr>
                <tr><td class="py-1">${t('rider')}:</td><td class="text-right font-bold">${typeCount.rider} (${((typeCount.rider/total)*100).toFixed(1)}%)</td></tr>
              </table>
            </div>
            <div>
              <h3 class="font-bold mb-2">${t('byLevel')}</h3>
              <table class="w-full">
        `;
        
        sortedLevels.slice(0,5).forEach(level => {
          const count = levelCount[level];
          html += `<tr><td class="py-1">${level}:</td><td class="text-right font-bold">${count} (${((count/total)*100).toFixed(1)}%)</td></tr>`;
        });
        
        html += `
              </table>
            </div>
            <div>
              <h3 class="font-bold mb-2">${t('bySlot')}</h3>
              <table class="w-full">
                <tr><td class="py-1">${t('slot1')}:</td><td class="text-right font-bold">${slotCount.slot1}</td></tr>
                <tr><td class="py-1">${t('slot2')}:</td><td class="text-right font-bold">${slotCount.slot2}</td></tr>
                <tr><td class="py-1">${t('any')}:</td><td class="text-right font-bold">${slotCount.any}</td></tr>
              </table>
            </div>
            <div class="md:col-span-2">
              <h3 class="font-bold mb-2">${t('byCaptain')}</h3>
              <table class="w-full">
                <tr><td class="py-1">${t('wantCaptain')}:</td><td class="text-right font-bold">${captainDesire['Да'] || 0}</td></tr>
                <tr><td class="py-1">${t('dontWantCaptain')}:</td><td class="text-right font-bold">${captainDesire['Нет'] || 0}</td></tr>
                <tr><td class="py-1">${t('indifferent')}:</td><td class="text-right font-bold">${captainDesire['Не важно'] || 0}</td></tr>
              </table>
            </div>
          </div>
        `;
        
        statsContainer.innerHTML = html;
        statsContainer.classList.remove('hidden');
      }

      function displayResults(data) {
        document.getElementById('results').classList.remove('hidden');
        displaySlotResults('slot1Results', data.slot1);
        displaySlotResults('slot2Results', data.slot2);
      }

      function displaySlotResults(containerId, slotData) {
        const container = document.getElementById(containerId);
        container.innerHTML = '';
        
        for (const [building, buildingData] of Object.entries(slotData)) {
          if (!buildingData.captain) continue;
          
          const buildingDiv = document.createElement('div');
          buildingDiv.className = 'border rounded p-4 mb-4';
          
          const buildingName = translations[`tower_${building}`] || building;
          const troopType = translations[buildingData.troop_type] || buildingData.troop_type;
          
          let html = `<h4 class="font-bold text-lg mb-2">🏰 ${buildingName} (${troopType})</h4>`;
          
          const captain = buildingData.captain;
          const captainAlliance = captain.alliance ? `(${captain.alliance}) ` : '';
          const captainMarch = buildingData.captain_march || captain.march_size;
          
          html += `<div class="mb-3 p-2 bg-yellow-100 rounded">
            <div class="font-semibold">${translations['captain']}: ${captainAlliance}${captain.nickname}</div>
            <div class="text-sm grid grid-cols-2 gap-2 mt-1">
              <span>${translations['ga']}: ${captain.group_attack?.toLocaleString()}</span>
              <span>${translations['march']}: ${captain.march_size?.toLocaleString()}</span>
              <span class="col-span-2 font-bold">${translations['captain']}: ${captainMarch.toLocaleString()}</span>
            </div>
          </div>`;
          
          if (buildingData.participants && buildingData.participants.length > 0) {
            html += `<div class="mb-2"><span class="font-semibold">${translations['participants']}:</span></div>`;
            html += '<div class="space-y-1">';
            
            const participantsWithMarch = buildingData.participants.map(participant => {
              const participantMarch = (buildingData.participants_march && buildingData.participants_march[participant.nickname]) 
                                      ? buildingData.participants_march[participant.nickname] 
                                      : participant.march_size;
              return { ...participant, march: participantMarch };
            });
            
            participantsWithMarch.sort((a, b) => b.march - a.march);
            
            participantsWithMarch.forEach((participant, index) => {
              const participantAlliance = participant.alliance ? `(${participant.alliance}) ` : '';
              
              html += `<div class="pl-4 py-1 border-b last:border-0 text-sm grid grid-cols-2 gap-2">
                <span>${index + 1}. ${participantAlliance}${participant.nickname}</span>
                <span class="font-mono text-right"> - ${participant.march.toLocaleString()}</span>
              </div>`;
            });
            html += '</div>';
            
            const participantsTotal = participantsWithMarch.reduce((sum, p) => sum + p.march, 0);
            const captainGA = captain.group_attack || 0;
            const usagePercent = captainGA > 0 ? ((participantsTotal / captainGA) * 100).toFixed(1) : 0;
            
            html += `<div class="mt-3 pt-2 border-t text-sm">
              <div class="flex justify-between">
                <span>${translations['totalParticipants']}:</span>
                <span class="font-bold">${participantsTotal.toLocaleString()}</span>
              </div>
              <div class="flex justify-between">
                <span>${translations['captainGA']}:</span>
                <span class="font-bold">${captainGA.toLocaleString()}</span>
              </div>
              <div class="flex justify-between ${participantsTotal > captainGA ? 'text-red-600 font-bold' : 'text-green-600'}">
                <span>${translations['usageGA']}:</span>
                <span>${usagePercent}%</span>
              </div>
            </div>`;
          } else {
            html += `<div class="text-gray-500 italic pl-4">${translations['no_participants']}</div>`;
          }
          
          buildingDiv.innerHTML = html;
          container.appendChild(buildingDiv);
        }
      }
    });
  </script>
</body>
</html>