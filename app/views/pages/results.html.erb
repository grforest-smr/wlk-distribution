<div class="w-full max-w-6xl mx-auto" data-controller="results">
  <h1 class="text-3xl font-bold text-center mb-8">📊 Результаты распределения</h1>
  
  <div class="mb-4 flex justify-between items-center">
    <button id="loadResults" data-action="click->results#load" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
      Загрузить результаты
    </button>
    <%= link_to "На главную", root_path, class: "text-blue-500 hover:text-blue-800" %>
  </div>

  <div id="resultsTable" class="hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white border border-gray-300">
        <thead>
          <tr class="bg-gray-100">
            <th class="px-4 py-2 border">Слот</th>
            <th class="px-4 py-2 border">Здание</th>
            <th class="px-4 py-2 border">Игрок</th>
            <th class="px-4 py-2 border">Роль</th>
            <th class="px-4 py-2 border">Войска</th>
          </tr>
        </thead>
        <tbody id="resultsBody">
        </tbody>
      </table>
    </div>
  </div>

  <div id="noResults" class="hidden text-center py-8 text-gray-500">
    Нет результатов за сегодня
  </div>
</div>